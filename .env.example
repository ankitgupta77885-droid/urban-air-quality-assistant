# ==============================================================================
# BreatheWell Environment Configuration
# ==============================================================================

# Google Gemini API key — obtain from https://aistudio.google.com/apikey
# Required for AI-personalized air quality advice
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model identifier (defaults to gemini-flash-lite-latest if omitted)
GEMINI_MODEL=gemini-flash-lite-latest

# HTTP server port for backend API
# Defaults to 3000 if omitted
PORT=3000

# Node execution environment: 'development', 'production', or 'test'
# Defaults to 'development' if omitted
NODE_ENV=development

# Minimum logging verbosity: 'debug', 'info', 'warn', or 'error'
# Defaults to 'info' if omitted
LOG_LEVEL=info

# Comma-separated list of allowed CORS origins in addition to localhost defaults
# Example: https://breathewell.example.com,https://app.breathewell.org
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
